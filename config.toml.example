[[accounts]]
jid = "user@example.com"
# password resolution order: OS keyring (service "kage", user = jid) -> password_cmd -> password
password_cmd = "pass show xmpp/user"
# password = "plaintext fallback, avoid if possible"
# gpg_key_id = "own key fingerprint, used to decrypt incoming messages"
# [accounts.gpg_peers]
# "friend@example.com" = "friend's key fingerprint, used to encrypt outgoing messages to them"

[keybinds]
quit = ["q", "ctrl+c"]
back = ["esc"]
switch = ["tab"]
focus_chats = ["\\"]
chat_open = ["l", "right"]
select_send = ["enter"]
message_up = ["k", "up"]
message_down = ["j", "down"]
delete = ["d"]
yank = ["y"]
edit = ["e"]
reply = ["r"]
info = ["ctrl+g"]
open = ["ctrl+o"]
save = ["ctrl+w"]
attach_file = ["ctrl+f"]
react = ["ctrl+t"]
add_account = ["a"]
confirm_yes = ["y"]
confirm_no = ["n", "esc"]

[theme]
app_bg = "#1e1e2e"
panel_bg = "#313244"
panel_alt_bg = "#45475a"
panel_edge = "#585b70"
log_bg = "#1e1e2e"
them_fg = "#cdd6f4"
text_muted = "#9399b2"
time = "#a6adc8"
border_d = "#45475a"
border_a = "#89b4fa"
accent_cyan = "#89dceb"
reply_fg = "#a6e3a1"
popup_bg = "#313244"
popup_danger = "#f38ba8"
filter_match = "#f9e2af"
nick_me = "#a6e3a1"
nick_them = "#89b4fa"
status_fg = "#cdd6f4"
notice_bg = "#45475a"
notice_fg = "#cdd6f4"
